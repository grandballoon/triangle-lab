{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The whole site: the built pages from dist/, the recall deck at /deck
	// (worker/), which keeps questions noted on one device on all the others,
	// /check, where Claude reads an answer given in a review, and /associate,
	// where it reads everything the learner can recall of the course. Pages and
	// Worker share one origin, so the site's storage and the sync key are its
	// own, and the pages call the Worker without CORS.
	"name": "triangle-lab",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"assets": {
		// Built by `npm run build`. Pages are served as they are, without
		// running the Worker; only /deck, /check and /associate run it.
		"directory": "./dist",
		"run_worker_first": ["/deck", "/check", "/associate"]
	},
	"durable_objects": {
		"bindings": [{ "name": "DECKS", "class_name": "RecallDeck" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RecallDeck"] }],
	// Requests per caller address, so the key cannot be guessed at speed. A
	// device syncs a few times a minute at most. The namespace id only has
	// to be unique within the Cloudflare account.
	// Checks are counted again against a tighter limit, since each one is a
	// paid call to Claude: a learner checks one answer at a time. Free
	// associations, read at /associate, count against the same limit.
	"ratelimits": [
		{ "name": "LIMITER", "namespace_id": "4207", "simple": { "limit": 60, "period": 60 } },
		{ "name": "CHECK_LIMITER", "namespace_id": "4208", "simple": { "limit": 10, "period": 60 } }
	],
	// Set with `npx wrangler secret put <NAME>`, never written here; locally
	// they come from .dev.vars. A deploy fails while either is unset.
	// RECALL_KEY: the key every request must carry.
	// ANTHROPIC_API_KEY: the Claude API key /check and /associate call Claude with.
	"secrets": { "required": ["RECALL_KEY", "ANTHROPIC_API_KEY"] },
	"vars": {
		// Where the Claude API is. Tests point it at a stand-in.
		"ANTHROPIC_BASE_URL": "https://api.anthropic.com"
	},
	"env": {
		// Staging, `npx wrangler deploy --env staging` (the Worker
		// triangle-lab-staging): the site as built by `npm run build:staging`,
		// which keeps the dev tools in, behind Cloudflare Access. It has its
		// own deck, sync key and rate limits, so testing never touches the
		// real ones, and serves the dev tools' endpoints (worker/staging.ts).
		// Bindings and vars are not inherited, so all are given again here.
		"staging": {
			"main": "worker/staging.ts",
			"assets": {
				"directory": "./dist-staging",
				"run_worker_first": ["/deck", "/check", "/associate", "/__step-source", "/__ui-feedback"]
			},
			"durable_objects": {
				"bindings": [
					{ "name": "DECKS", "class_name": "RecallDeck" },
					// Alt-click comments, kept until `npm run staging:pull`.
					{ "name": "INBOX", "class_name": "StagingInbox" }
				]
			},
			"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RecallDeck", "StagingInbox"] }],
			"ratelimits": [
				{ "name": "LIMITER", "namespace_id": "4209", "simple": { "limit": 60, "period": 60 } },
				{ "name": "CHECK_LIMITER", "namespace_id": "4210", "simple": { "limit": 10, "period": 60 } }
			],
			// As above, plus GITHUB_TOKEN: a fine-grained token for this
			// repository only, with read and write access to its contents,
			// which step edits are committed with.
			"secrets": { "required": ["RECALL_KEY", "ANTHROPIC_API_KEY", "GITHUB_TOKEN"] },
			"vars": {
				"ANTHROPIC_BASE_URL": "https://api.anthropic.com",
				// Where step edits are committed. A push there redeploys
				// staging (.github/workflows/staging.yml).
				"GITHUB_API_URL": "https://api.github.com",
				"GITHUB_REPO": "grandballoon/triangle-lab",
				"GITHUB_BRANCH": "staging",
				// The Cloudflare Access application in front of staging
				// (README.md, "Staging"): the team's issuer,
				// https://<team>.cloudflareaccess.com, and the application's
				// audience tag. While either is empty the dev tools' endpoints
				// answer 503.
				"ACCESS_ISSUER": "",
				"ACCESS_AUD": ""
			}
		}
	}
}
