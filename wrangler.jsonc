{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The whole site: the built pages from dist/, signing in by email link at
	// /auth/* (worker/auth.ts), the recall deck at /deck (worker/), which keeps
	// the questions a learner notes on one device on all the others,
	// /check, where Claude reads an answer given in a review, /associate,
	// where it reads everything the learner can recall of the course, and
	// /explain, where it checks a lesson's idea explained on the lesson page. Pages and
	// Worker share one origin, so the session cookie that signing in sets
	// (/auth/*) is the site's own, and the pages call the Worker without CORS.
	"name": "triangle-lab",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"assets": {
		// Built by `npm run build`. Pages are served as they are, without
		// running the Worker; only /auth/*, /deck, /check, /associate and /explain run it.
		"directory": "./dist",
		"run_worker_first": ["/auth/*", "/deck", "/check", "/associate", "/explain"]
	},
	"durable_objects": {
		"bindings": [
			// A deck per learner (worker/rules.ts `deckFor`).
			{ "name": "DECKS", "class_name": "RecallDeck" },
			// The sign-in links sent and the sessions made from them (worker/accounts.ts).
			{ "name": "ACCOUNTS", "class_name": "Accounts" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["RecallDeck"] },
		{ "tag": "v2", "new_sqlite_classes": ["Accounts"] }
	],
	// Sign-in links are sent with Cloudflare Email Sending, from SENDER, an
	// address on a domain onboarded to it (README.md, "Signing in").
	"send_email": [{ "name": "EMAIL" }],
	// Requests per caller address, so nothing can be guessed at speed. A
	// device syncs a few times a minute at most. The namespace id only has
	// to be unique within the Cloudflare account.
	// Checks are counted again against a tighter limit, since each one is a
	// paid call to Claude: a learner checks one answer at a time. Free
	// associations, read at /associate, and explanations, checked at /explain,
	// count against the same limit.
	// Sign-in links are counted by the address asked for, so nobody's inbox
	// can be flooded with them.
	"ratelimits": [
		{ "name": "LIMITER", "namespace_id": "4207", "simple": { "limit": 60, "period": 60 } },
		{ "name": "CHECK_LIMITER", "namespace_id": "4208", "simple": { "limit": 10, "period": 60 } },
		{ "name": "LINK_LIMITER", "namespace_id": "4211", "simple": { "limit": 3, "period": 60 } }
	],
	// Set with `npx wrangler secret put <NAME>`, never written here; locally
	// they come from .dev.vars. A deploy fails while any is unset.
	// ANTHROPIC_API_KEY: the Claude API key /check, /associate and /explain call Claude with.
	// OWNER_EMAIL: the email the owner signs in with, whose deck is the one
	// the site held while it had one learner (worker/rules.ts `deckFor`).
	// INVITES: everyone else who may sign in, email addresses separated by
	// commas, or `-` for no one (worker/auth.ts). Each gets a deck of their own.
	// The two addresses are secrets only to keep them out of this public repository.
	"secrets": { "required": ["ANTHROPIC_API_KEY", "OWNER_EMAIL", "INVITES"] },
	"vars": {
		// Where the Claude API is. Tests point it at a stand-in.
		"ANTHROPIC_BASE_URL": "https://api.anthropic.com",
		// The address sign-in links are sent from, on a domain onboarded to
		// Cloudflare Email Sending. While it is empty no one can sign in, and
		// `npm run deploy` stops (tools/deploy-guard.ts).
		"SENDER": "signin@geometryclub.app"
	},
	"env": {
		// Staging, `npx wrangler deploy --env staging` (the Worker
		// triangle-lab-staging): the site as built by `npm run build:staging`,
		// which keeps the dev tools in, behind Cloudflare Access. It has its
		// own decks, sign-ins and rate limits, so testing never touches the
		// real ones, and serves the dev tools' endpoints (worker/staging.ts).
		// Bindings and vars are not inherited, so all are given again here.
		"staging": {
			"main": "worker/staging.ts",
			"assets": {
				"directory": "./dist-staging",
				"run_worker_first": ["/auth/*", "/deck", "/check", "/associate", "/explain", "/__step-source", "/__ui-feedback"]
			},
			"durable_objects": {
				"bindings": [
					{ "name": "DECKS", "class_name": "RecallDeck" },
					{ "name": "ACCOUNTS", "class_name": "Accounts" },
					// Alt-click comments, kept until `npm run staging:pull`.
					{ "name": "INBOX", "class_name": "StagingInbox" }
				]
			},
			"migrations": [
				{ "tag": "v1", "new_sqlite_classes": ["RecallDeck", "StagingInbox"] },
				{ "tag": "v2", "new_sqlite_classes": ["Accounts"] }
			],
			"send_email": [{ "name": "EMAIL" }],
			"ratelimits": [
				{ "name": "LIMITER", "namespace_id": "4209", "simple": { "limit": 60, "period": 60 } },
				{ "name": "CHECK_LIMITER", "namespace_id": "4210", "simple": { "limit": 10, "period": 60 } },
				{ "name": "LINK_LIMITER", "namespace_id": "4212", "simple": { "limit": 3, "period": 60 } }
			],
			// As above, plus GITHUB_TOKEN: a fine-grained token for this
			// repository only, with read and write access to its contents,
			// which step edits are committed with.
			"secrets": { "required": ["ANTHROPIC_API_KEY", "OWNER_EMAIL", "INVITES", "GITHUB_TOKEN"] },
			"vars": {
				"ANTHROPIC_BASE_URL": "https://api.anthropic.com",
				"SENDER": "signin@geometryclub.app",
				// Where step edits are committed. A push there redeploys
				// staging (.github/workflows/staging.yml).
				"GITHUB_API_URL": "https://api.github.com",
				"GITHUB_REPO": "grandballoon/triangle-lab",
				"GITHUB_BRANCH": "staging",
				// The Cloudflare Access application in front of staging
				// (README.md, "Staging"), which keeps staging to you: the team's
				// issuer, https://<team>.cloudflareaccess.com, and the
				// application's audience tag. The dev tools' endpoints check its
				// token, and answer 503 while either is empty; the deck is the
				// signed-in learner's, as in production.
				"ACCESS_ISSUER": "https://nameless-frog-5ff8.cloudflareaccess.com",
				"ACCESS_AUD": "630624a9db51760184be60564f9191e77ef7aaeca8241f3c45b6fcc6a96c06cb"
			}
		}
	}
}
