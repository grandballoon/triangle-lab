{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The whole site: the built pages from dist/, the recall deck at /deck
	// (worker/), which keeps questions noted on one device on all the others,
	// /check, where Claude reads an answer given in a review, and /material,
	// the key facts and reference answers it reads them against, which the
	// admin page edits. Pages and Worker share one origin, so the site's
	// storage and its keys are its own, and the pages call the Worker
	// without CORS.
	"name": "triangle-lab",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-19",
	"observability": {
		"enabled": true
	},
	"assets": {
		// Built by `npm run build`. Pages are served as they are, without
		// running the Worker; only /deck, /check and /material run it.
		"directory": "./dist",
		"run_worker_first": ["/deck", "/check", "/material"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "DECKS", "class_name": "RecallDeck" },
			{ "name": "MATERIAL", "class_name": "Material" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["RecallDeck"] },
		{ "tag": "v2", "new_sqlite_classes": ["Material"] }
	],
	// Requests per caller address, so the key cannot be guessed at speed. A
	// device syncs a few times a minute at most. The namespace id only has
	// to be unique within the Cloudflare account.
	// Checks are counted again against a tighter limit, since each one is a
	// paid call to Claude: a learner checks one answer at a time. So are
	// changes to the material, most of which Claude writes; the admin page
	// writes a lesson's missing key facts one after another.
	"ratelimits": [
		{ "name": "LIMITER", "namespace_id": "4207", "simple": { "limit": 60, "period": 60 } },
		{ "name": "CHECK_LIMITER", "namespace_id": "4208", "simple": { "limit": 10, "period": 60 } },
		{ "name": "WRITE_LIMITER", "namespace_id": "4209", "simple": { "limit": 30, "period": 60 } }
	],
	// Set with `npx wrangler secret put <NAME>`, never written here; locally
	// they come from .dev.vars. A deploy fails while any is unset.
	// RECALL_KEY: the key every request to /deck and /check must carry.
	// ADMIN_KEY: the key every request to /material must carry.
	// ANTHROPIC_API_KEY: the Claude API key the Worker calls Claude with.
	"secrets": { "required": ["RECALL_KEY", "ADMIN_KEY", "ANTHROPIC_API_KEY"] },
	"vars": {
		// Where the Claude API is. Tests point it at a stand-in.
		"ANTHROPIC_BASE_URL": "https://api.anthropic.com"
	}
}
