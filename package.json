{
  "name": "triangle-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p worker && vite build",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "deploy": "node tools/syllabus.ts refresh && npm run build && wrangler deploy",
    "build:staging": "tsc && tsc -p worker && vite build --mode staging --outDir dist-staging",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "staging:pull": "node tools/staging.ts pull",
    "worker:types": "wrangler types worker/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@babel/types": "^7.29.11",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.4",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@babel/parser": "^7.29.12",
    "@mediapipe/tasks-vision": "^0.10.35",
    "katex": "^0.19.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
